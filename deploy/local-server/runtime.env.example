# Copy to runtime.env on the server and keep it private (chmod 600).
# This single file is used both for Compose interpolation and API runtime config.

# Docker/LAN binding
RAWAQAN_BIND_IP=127.0.0.1
RAWAQAN_API_PORT=4000
RAWAQAN_WEB_PORT=8280
RAWAQAN_RUNTIME_ENV_FILE=runtime.env

# Dedicated PostgreSQL container
POSTGRES_USER=rawaqan
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_DB=rawaqan

# API
NODE_ENV=production
PORT=4000
HEALTH_DATABASE_TIMEOUT_MS=3000
CORS_ORIGINS=https://rawqan-frontend-sigma.vercel.app,https://rawaqan.ragheed-server
PUBLIC_SITE_URL=https://rawqan-frontend-sigma.vercel.app

# Authentication (generate each value independently)
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Offline POS signing keys (Ed25519 DER, base64)
POS_OFFLINE_CAPABILITY_TTL_DAYS=7
POS_OFFLINE_PRIVATE_KEY_BASE64=replace-with-generated-private-key
POS_OFFLINE_PUBLIC_KEY_BASE64=replace-with-generated-public-key

# Optional Cloudinary uploads. Existing image URLs keep working when blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=rawaqan

# Seed values are only used by an explicit seed command, not normal startup.
SEED_ADMIN_EMAIL=admin@rawaqan.local
SEED_ADMIN_PASSWORD=replace-with-a-long-random-value
SEED_ADMIN_NAME=Rawaqan Admin
