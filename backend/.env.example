# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Maximum time the public readiness endpoint waits for PostgreSQL.
HEALTH_DATABASE_TIMEOUT_MS=3000
# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ─── Database (PostgreSQL) ────────────────────────────────
# Runtime (pooled) connection. On Neon use the *-pooler* host with ?pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rawaqan?schema=public"
# Direct (non-pooled) connection for Prisma migrations. On Neon use the direct
# host (no -pooler). Locally/Docker it's the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rawaqan?schema=public"

# ─── Operational full-database backup ─────────────────────
# Set these only in the terminal/session used for backup operations. The
# restore target MUST be a disposable database whose name contains test,
# restore, staging, or sandbox. Never point it at production.
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
DATABASE_BACKUP_DIR=../backups
POSTGRES_TOOLS_IMAGE=postgres:18-alpine

# ─── Auth (JWT) ───────────────────────────────────────────
# Use long random strings in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Brute-force lockout: lock an account after N failed logins for M minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Device-bound offline capability (Ed25519 PKCS8 private/SPKI public DER,
# base64-encoded). Generate once and keep the private key server-only.
POS_OFFLINE_CAPABILITY_TTL_DAYS=7
POS_OFFLINE_PRIVATE_KEY_BASE64=
POS_OFFLINE_PUBLIC_KEY_BASE64=

# ─── Cloudinary (image storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=rawaqan

# ─── Seed admin (first run only) ──────────────────────────
SEED_ADMIN_EMAIL=admin@rawaqan.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Rawaqan Admin

# ─── Public site URL (for QR generation) ──────────────────
PUBLIC_SITE_URL=http://localhost:5173
