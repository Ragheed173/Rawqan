# Base URL of the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api
# Fail cloud calls quickly while local POS data remains safe and retryable.
VITE_API_TIMEOUT_MS=12000

# Public site URL (used for canonical/OG tags)
VITE_SITE_URL=http://localhost:5173

# Optional production error monitoring. Keep the DSN in Vercel environment
# variables; never commit a private auth token.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_RELEASE=
